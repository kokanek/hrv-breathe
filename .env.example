MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Cloudflare auth Worker that issues login tokens. /api/login proxies here.
# Include the /login path.
AUTH_WORKER_URL=https://<your-worker>.workers.dev/login

# HS256 secret used to VERIFY tokens minted by the auth Worker. Must match the
# Worker's JWT_SECRET exactly, or every request will fail with 401.
JWT_SECRET=<must-match-the-worker>

# Optional. Only set if the Worker also has PROXY_SECRET set — the value must
# match so the Worker accepts requests only from this backend.
# PROXY_SECRET=<shared-with-the-worker>
