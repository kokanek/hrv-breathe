# Block packages published less than 7 days ago (prevents fast-follow supply chain attacks)
delay-deprecated-and-new-packages-threshold=10080

# Prevent transitive dependencies from pulling code via raw Git URLs
block-exotic-sub-dependencies=true

# Fail the install if a package's trust level drops compared to previous releases.
# NOTE: Detected trust downgrade in semver@6.3.1 (via eslint-plugin-react-hooks →
# @babel/core). Earlier versions had provenance attestation; 6.3.1 does not.
# Audit before re-enabling: https://www.npmjs.com/package/semver?activeTab=versions
# trust-policy=no-downgrade
